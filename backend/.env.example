# Optional. Leave blank to use the deterministic keyword fallback. Synthetic demo text only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Per-process demo endpoint rate limit
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# For local Vite development. Set your deployed frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
